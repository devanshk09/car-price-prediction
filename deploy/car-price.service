[Unit]
Description=Used Car Price Prediction (FastAPI)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/car-price-prediction
Environment=PYTHONUNBUFFERED=1
# Written by CodeBuild: which S3 bucket/prefix to load the model from.
EnvironmentFile=-/opt/car-price-prediction/deploy/app.env
# Port 80 normally needs root; this capability lets the ubuntu user bind it.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/opt/car-price-venv/bin/uvicorn app:app --host 0.0.0.0 --port 80 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
